# ============================================================================
# Variáveis de ambiente — COPIE este arquivo para .env.local e preencha.
#   PowerShell:  Copy-Item .env.local.example .env.local
# NUNCA comite o .env.local com valores reais.
# ============================================================================

# Qual provider de LLM usar como principal: providerA (Gemini) ou providerB (NVIDIA).
# O outro é usado automaticamente como fallback se o principal falhar.
LLM_PROVIDER=providerA

# --- Provider A = Google Gemini -------------------------------------------
# Pegue a chave gratuita em: https://aistudio.google.com/apikey
PROVIDER_A_API_KEY=
PROVIDER_A_MODEL=gemini-1.5-flash

# --- Provider B = NVIDIA NIM (build.nvidia.com) ---------------------------
# Pegue a chave gratuita em: https://build.nvidia.com  (escolha um modelo -> Get API Key)
# Dica: use um modelo instruct rápido que devolva JSON (evite modelos "reasoning",
# que respondem com texto de raciocínio em vez de JSON).
PROVIDER_B_API_KEY=
PROVIDER_B_MODEL=meta/llama-3.1-8b-instruct

# --- Supabase (opcional no início; o app funciona sem, usando sessionStorage) ---
# Painel do projeto: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags (mantenha desligadas no MVP) ---------------------------
ENABLE_SCRAPING=false
ENABLE_PAYMENTS=false
# Versão pública (client) da flag de pagamentos, usada pelo PaywallGate.
NEXT_PUBLIC_ENABLE_PAYMENTS=false
